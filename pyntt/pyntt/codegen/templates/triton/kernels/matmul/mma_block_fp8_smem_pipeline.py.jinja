{{ "@triton.jit(noinline=True)" if model["NoInline"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__producer(writer, {{ helper_parameters(model) }}):
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    active_n = {{ dim(ctx["n"]) }}
    runtime_num_n_tiles = {{ ctx["runtime_num_n_tiles"] }}
    for n_tile in tl.range(0, runtime_num_n_tiles):
{% for chunk in range(ctx["rhs_descriptor_chunks_per_tile"]) %}
        rhs_descriptor_entry_{{ chunk }} = tle.gpu.tensor_map_table_entry(
            {{ ctx["rhs_descriptor_name"] }},
            shard_index * {{ ctx["rhs_descriptor_entries_per_owner"] }}
            + n_tile * {{ ctx["rhs_descriptor_chunks_per_tile"] }}
            + {{ chunk }},
        )
        tle.gpu.tensor_map_fenceproxy_acquire(rhs_descriptor_entry_{{ chunk }})
{% endfor %}
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            slot = writer.acquire(sequence)
{% for transfer in range(ctx["transfers_per_stage"]) %}
{% for chunk in range(ctx["rhs_descriptor_chunks_per_tile"]) %}
            weight_{{ transfer }}_destination_{{ chunk }} = tle.gpu.alloc(
                [{{ ctx["tma_block_shape"] | join(", ") }}],
                dtype={{ model["RhsTritonDType"] }},
{% if ctx["use_nv_mma_weight_stage"] %}
                layout=None,
{% else %}
                layout=tle.gpu.nv_tma_shared_layout(
                    [{{ ctx["tma_block_shape"] | join(", ") }}],
                    [{{ range(ctx["tma_block_shape"] | length) | reverse | join(", ") }}],
                    {{ model["RhsTritonDType"] }},
                    [{{ ([1] * (ctx["tma_block_shape"] | length)) | join(", ") }}],
                    [{{ ([1] * (ctx["tma_block_shape"] | length)) | join(", ") }}],
                    [{{ range(ctx["tma_block_shape"] | length) | reverse | join(", ") }}],
                    False, True,
                ),
{% endif %}
                scope=tle.gpu.smem,
                alias=slot.weight_{{ transfer }},
                alias_offset_bytes={{ chunk * ctx["tma_n_elements"] * ctx["transfer_block_k"] * ctx["rhs_scalar_bytes"] }},
                nv_mma_shared_layout={{ ctx["use_nv_mma_weight_stage"] }},
            )
            rhs_{{ transfer }}_descriptor_{{ chunk }} = tle.gpu.reinterpret_tensor_map(
                rhs_descriptor_entry_{{ chunk }},
                weight_{{ transfer }}_destination_{{ chunk }},
            )
            tle.gpu.copy(
                rhs_{{ transfer }}_descriptor_{{ chunk }},
                weight_{{ transfer }}_destination_{{ chunk }},
                [{{ ctx["tma_block_shape"] | join(", ") }}],
                offsets=[
{% for offset in ctx["transfer_descriptor_offsets"][transfer] %}
                    {{ tma_offset(offset) }},
{% endfor %}
                ],
                eviction_policy="evict_first",
            )
{% endfor %}
{% endfor %}
            writer.commit(sequence)
    writer.close(
        (runtime_num_n_tiles * {{ ctx["num_k_tiles"] }}).to(tl.int32)
    )


{{ "@triton.jit(noinline=True)" if model["NoInline"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__{{ "consumer_compute" if ctx["auxiliary_only"] else "consumer" }}(
    reader,
    lhs_quantized_stage,
    lhs_scale_stage,
{% if ctx["use_complete_consumer_lhs_stage"] %}
    lhs_stage,
{% endif %}
    {{ helper_parameters(model) }}
):
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    lhs = {{ ptr(model, "Lhs") }}
    rhs_scale = {{ ptr(model, "RhsScale") }}
    output = {{ ptr(model, "Output") }}
{% if model["HasAddend"] %}
    addend = {{ ptr(model, "Addend") }}
{% endif %}
{% if model["HasNormStats"] %}
    stats = {{ ptr(model, "Stats") }}
{% if model["UseMean"] %}
    stats_sum = 0.0
{% endif %}
    stats_square_sum = 0.0
{% endif %}
    quantization_k = tle.encoding(
        tl.broadcast_to(
            tl.arange(0, {{ ctx["reduction_group"] }})[None, :],
            ({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
        ),
        {{ model["FunctionName"] }}__activation_quantization_layout,
    )
    local_n = tle.encoding(
        tl.arange(0, {{ ctx["block_n"] }}),
        {{ model["FunctionName"] }}__output_layout,
    )
    local_column = tle.encoding(
        tl.arange(0, {{ ctx["mma_instruction_n"] }})[None, :],
        {{ model["FunctionName"] }}__mma_layout,
    )
    active_n = {{ dim(ctx["n"]) }}
    runtime_num_n_tiles = {{ ctx["runtime_num_n_tiles"] }}
{% if ctx["materialize_complete_lhs_quantization"] %}
    stage_quantization_group = tle.encoding(
        tl.broadcast_to(
            tl.arange(0, {{ ctx["mma_instruction_n"] }})[:, None],
            ({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
        ),
        {{ model["FunctionName"] }}__activation_quantization_layout,
    )
    stage_input_row = tle.encoding(
        tl.zeros(
            ({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
            tl.int32,
        ),
        {{ model["FunctionName"] }}__activation_quantization_layout,
    )
{% if ctx["use_complete_consumer_lhs_stage"] %}
{% for segment in ctx["lhs_copy_segments"] %}
    input_copy_offset_{{ loop.index0 }} = tle.encoding(
        tl.arange(0, {{ segment["extent"] }})[None, :],
        {{ ctx["consumer_input_copy_layout_name"] }},
    )
    pipeline_input_copy_k = {{ segment["offset"] }} + input_copy_offset_{{ loop.index0 }}
    tle.gpu.copy(
        {{ access_pointer(model, "Lhs", "lhs", segment["access"]) }},
        lhs_stage.subslice(
            [0, {{ segment["offset"] }}],
            [1, {{ segment["extent"] }}],
        ),
        [1, {{ segment["extent"] }}],
        is_async=True,
        eviction_policy="evict_last",
    )
{% endfor %}
    tle.gpu.async_commit_group()
    tle.gpu.async_wait_group(0)
    tl.debug_barrier()
{% endif %}
    for quantize_group_base in tl.range(
        0,
        {{ ctx["logical_activation_group_count"] }},
        {{ ctx["mma_instruction_n"] }},
    ):
        quantize_group = (
            quantize_group_base + stage_quantization_group
        )
        quantize_group_valid = (
            quantize_group < {{ ctx["logical_activation_group_count"] }}
        )
        pipeline_offs_k = (
            quantize_group * {{ ctx["reduction_group"] }} + quantization_k
        )
        staged_lhs_value = tl.load(
{% if ctx["use_complete_consumer_lhs_stage"] %}
            tle.gpu.local_ptr(
                lhs_stage,
                (stage_input_row, pipeline_offs_k),
                shape=({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
            ),
{% else %}
            {{ access_pointer(model, "Lhs", "lhs", ctx["pipeline_lhs_access"]) }},
{% endif %}
            mask=quantize_group_valid,
            other=0.0,
        ).to(tl.float32)
        staged_lhs_scale = tl.maximum(
            tl.max(tl.abs(staged_lhs_value), axis=1) / 448.0,
            1.0e-12,
        )
        tl.store(
            tle.gpu.local_ptr(
                lhs_quantized_stage,
                (quantize_group, quantization_k),
                shape=({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
            ),
            (staged_lhs_value / staged_lhs_scale[:, None]).to(tl.float8e4nv),
            mask=quantize_group_valid,
        )
        tl.store(
            tle.gpu.local_ptr(
                lhs_scale_stage,
                (quantize_group, stage_input_row),
                shape=({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
            ),
            tl.broadcast_to(
                staged_lhs_scale[:, None],
                ({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
            ),
            mask=(
                quantize_group_valid & (quantization_k == 0)
            ),
        )
    tl.debug_barrier()
{% endif %}
    for n_tile in tl.range(0, runtime_num_n_tiles):
        output_n = n_tile * {{ ctx["block_n"] }} + local_n
        global_output_n = {{ ctx["global_output_n"] }}
        weight_scale_n = global_output_n // {{ ctx["weight_block_n"] }}
{% if ctx["fragment_accumulate_mma"] %}
        result = tle.encoding(
            tl.zeros(
                ({{ ctx["block_n"] }}, {{ ctx["mma_instruction_n"] }}),
                tl.float32,
            ),
            {{ model["FunctionName"] }}__mma_layout,
        )
{% else %}
        result = tle.encoding(
            tl.zeros(({{ ctx["block_n"] }},), tl.float32),
            {{ model["FunctionName"] }}__output_layout,
        )
{% endif %}
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            ready = reader.wait(sequence)
{% for group in range(ctx["reduction_groups_per_stage"]) %}
{% set transfer = group // ctx["reduction_groups_per_transfer"] %}
{% set transfer_group = group % ctx["reduction_groups_per_transfer"] %}
{% if ctx["reuse_complete_lhs_quantization"] %}
            activation_group_{{ group }} = (
                k_tile * {{ ctx["reduction_groups_per_stage"] }} + {{ group }}
            )
            lhs_group_scale_{{ group }} = tl.load(
                tle.gpu.local_ptr(
                    lhs_scale_stage,
                    (activation_group_{{ group }}, 0),
                ),
                mask=(activation_group_{{ group }} < {{ ctx["logical_activation_group_count"] }}),
                other=0.0,
            )
            lhs_quantized_{{ group }} = tle.encoding(
                tl.trans(
                    tl.load(
                        tle.gpu.local_ptr(
                            lhs_quantized_stage,
                            (
                                tle.encoding(
                                    tl.broadcast_to(
                                        activation_group_{{ group }},
                                        ({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
                                    ),
                                    {{ model["FunctionName"] }}__activation_quantization_layout,
                                ),
                                quantization_k,
                            ),
                            shape=({{ ctx["mma_instruction_n"] }}, {{ ctx["reduction_group"] }}),
                        ),
                        mask=(activation_group_{{ group }} < {{ ctx["logical_activation_group_count"] }}),
                        other=0.0,
                    )
                ),
                {{ model["FunctionName"] }}__activation_dot_layout,
            )
            lhs_group_scale_output_{{ group }} = tle.encoding(
                tl.broadcast_to(
                    lhs_group_scale_{{ group }},
                    ({{ ctx["block_n"] }},),
                ),
                {{ model["FunctionName"] }}__output_layout,
            )
{% else %}
            pipeline_offs_k = (
                k_tile * {{ ctx["block_k"] }}
                + {{ group * ctx["reduction_group"] }}
                + quantization_k
            )
            lhs_value_{{ group }} = tl.load(
                {{ access_pointer(model, "Lhs", "lhs", ctx["pipeline_lhs_access"]) }}
            ).to(tl.float32)
            lhs_group_scale_{{ group }} = tl.maximum(
                tl.max(tl.abs(lhs_value_{{ group }}), axis=1) / 448.0,
                1.0e-12,
            )
            lhs_quantized_{{ group }} = tle.encoding(
                tl.trans(
                    (
                        lhs_value_{{ group }}
                        / lhs_group_scale_{{ group }}[:, None]
                    ).to(tl.float8e4nv)
                ),
                {{ model["FunctionName"] }}__activation_dot_layout,
            )
            lhs_group_scale_output_{{ group }} = tle.encoding(
                tl.reshape(
                    tl.broadcast_to(
                        lhs_group_scale_{{ group }}[:, None],
                        (
                            {{ ctx["mma_instruction_n"] }},
                            {{ ctx["block_n"] // ctx["mma_instruction_n"] }},
                        ),
                    ),
                    ({{ ctx["block_n"] }},),
                ),
                {{ model["FunctionName"] }}__output_layout,
            )
{% endif %}
            group = {{ group }}
            global_k_start = {{ ctx["global_k_start"] }}
            weight_scale_k = global_k_start // {{ ctx["weight_block_k"] }}
            weight_scale_value_{{ group }} = tl.load(
                {{ access_pointer(model, "RhsScale", "rhs_scale", ctx["rhs_scale_access"]) }},
                mask=(output_n < active_n){% if ctx["reuse_complete_lhs_quantization"] %} & (activation_group_{{ group }} < {{ ctx["logical_activation_group_count"] }}){% endif %},
                other=0.0,
            ).to(tl.float32)
            weight_value_{{ group }} = tle.encoding(
                tl.load(
                    tle.gpu.local_ptr(
                        ready.slot.weight_{{ transfer }}.subslice(
                            [{{ transfer_group }}, 0, 0],
                            [1, {{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}],
                        )
                    )
                ).reshape(({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }})),
                {{ model["FunctionName"] }}__weight_dot_layout,
            )
            mma_result_{{ group }} = tl.dot(
                weight_value_{{ group }},
                lhs_quantized_{{ group }},
                acc=tle.encoding(
                    tl.zeros(({{ ctx["block_n"] }}, {{ ctx["mma_instruction_n"] }}), tl.float32),
                    {{ model["FunctionName"] }}__mma_layout,
                ),
                out_dtype=tl.float32,
            )
{% if ctx["fragment_accumulate_mma"] %}
            group_scale_{{ group }} = (
                weight_scale_value_{{ group }}
                * lhs_group_scale_output_{{ group }}
            )
            group_scale_fragment_{{ group }} = tle.encoding(
                tl.broadcast_to(
                    group_scale_{{ group }}[:, None],
                    ({{ ctx["block_n"] }}, {{ ctx["mma_instruction_n"] }}),
                ),
                {{ model["FunctionName"] }}__mma_layout,
            )
            result += (
                mma_result_{{ group }}
                * group_scale_fragment_{{ group }}
            )
{% else %}
            group_result_{{ group }} = tle.encoding(
                tl.sum(
                    tl.where(local_column == 0, mma_result_{{ group }}, 0.0),
                    axis=1,
                ),
                {{ model["FunctionName"] }}__output_layout,
            )
            result += (
                group_result_{{ group }}
                * weight_scale_value_{{ group }}
                * lhs_group_scale_output_{{ group }}
            )
{% endif %}
{% endfor %}
            reader.release(sequence)

{% if ctx["fragment_accumulate_mma"] %}
        result = tle.encoding(
            tl.sum(
                tl.where(local_column == 0, result, 0.0),
                axis=1,
            ),
            {{ model["FunctionName"] }}__output_layout,
        )
{% endif %}
        pipeline_output_n = output_n
        output_value = (result * {{ model["Scale"] }}).to({{ model["OutputTritonDType"] }})
{% if model["HasAddend"] %}
        addend_value = tl.load(
            {{ access_pointer(model, "Addend", "addend", ctx["pipeline_addend_access"]) }},
            mask={{ ctx["pipeline_output_mask"] }},
            other=0.0,
        )
        output_value = (output_value + addend_value).to({{ model["OutputTritonDType"] }})
{% endif %}
        tl.store(
            {{ access_pointer(model, "Output", "output", ctx["pipeline_output_access"]) }},
            output_value,
            mask={{ ctx["pipeline_output_mask"] }},
        )
{% if model["HasNormStats"] %}
        stats_value = output_value.to(tl.float32)
        stats_value = tl.where(
            {{ ctx["pipeline_output_mask"] }},
            stats_value,
            0.0,
        )
{% if model["UseMean"] %}
        stats_sum += tl.sum(stats_value, axis=None)
{% endif %}
        stats_square_sum += tl.sum(stats_value * stats_value, axis=None)
{% endif %}
{% if model["HasNormStats"] %}
{% if model["UseMean"] %}
    tl.store({{ access_pointer(model, "Stats", "stats", ctx["pipeline_stats_accesses"][0]) }}, stats_sum, mask=True)
    tl.store({{ access_pointer(model, "Stats", "stats", ctx["pipeline_stats_accesses"][1]) }}, stats_square_sum, mask=True)
{% else %}
    tl.store({{ access_pointer(model, "Stats", "stats", ctx["pipeline_stats_accesses"][0]) }}, stats_square_sum, mask=True)
{% endif %}
{% endif %}


