{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_elementwise.py.jinja" as elementwise with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = memcopy_context(model) %}
# generated from PyNTT Jinja Memcopy.py.jinja
# {{ model["Comment"] }}; dtype={{ model["DType"] }}, shape={{ shape_tuple(model["Shape"]) }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    source = {{ ptr(model, "Source") }}
    destination = {{ ptr(model, "Destination") }}
{% call(indent) elementwise.iterate(ctx) %}
{{ indent }}value = tl.load({{ access_pointer(model, "Source", "source", ctx["source_access"]) }}, mask={{ access_boundary_mask(ctx["source_access"]) }}, other=0.0)
{{ indent }}tl.store({{ access_pointer(model, "Destination", "destination", ctx["destination_access"]) }}, value, mask={{ access_boundary_mask(ctx["destination_access"]) }})
{% endcall %}


{{ phases.dispatch(model) }}
