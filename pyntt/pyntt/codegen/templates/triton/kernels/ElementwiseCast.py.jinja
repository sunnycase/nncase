{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_elementwise.py.jinja" as elementwise with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = elementwise_cast_context(model) %}
# generated from PyNTT Jinja ElementwiseCast.py.jinja
# {{ model["Comment"] }}; cast_mode={{ model["CastMode"] }}, input_dtype={{ model["InputDType"] }}, output_dtype={{ model["OutputDType"] }}, shape={{ shape_tuple(model["Shape"]) }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    input0 = {{ ptr(model, "Input") }}
    output = {{ ptr(model, "Output") }}
{% call(indent) elementwise.iterate(ctx) %}
{{ indent }}value0 = tl.load({{ access_pointer(model, "Input", "input0", ctx["input_access"]) }}, mask={{ access_boundary_mask(ctx["input_access"]) }}, other=0.0)
{{ indent }}result = {{ model["CastExpression"] }}
{{ indent }}tl.store({{ access_pointer(model, "Output", "output", ctx["output_access"]) }}, {{ "(result).to(tl.uint8)" if is_bool_dtype(model["OutputDType"]) else "result" }}, mask={{ access_boundary_mask(ctx["output_access"]) }})
{% endcall %}


{{ phases.dispatch(model) }}
