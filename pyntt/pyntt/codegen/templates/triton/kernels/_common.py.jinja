{% macro mesh_coordinates(mesh_axes) -%}
{% set linear = namespace(expression="") %}
{% for axis in mesh_axes %}
{% if axis["level"] == "b" %}
    shard_coord{{ axis["placement_axis"] }} = tle.shard_id(PYNTT_GRID_MESH, {{ pyrepr(axis["name"]) }}).to(tl.int64)
{% else %}
    shard_coord{{ axis["placement_axis"] }} = 0
{% endif %}
{% set coord = "shard_coord" ~ axis["placement_axis"] %}
{% if loop.first %}
{% set linear.expression = coord %}
{% else %}
{% set linear.expression = "(" ~ linear.expression ~ " * " ~ axis["size"] ~ " + " ~ coord ~ ")" %}
{% endif %}
{% endfor %}
    shard_index = {{ linear.expression }}
{%- endmacro %}

{% macro structured_axis(axis, indent="") -%}
{{ indent }}{{ axis["name"] }}_physical = {% if axis["physical_base"] != "0" %}({{ axis["physical_base"] }} + {% endif %}tl.arange(0, {{ axis["physical_block_extent"] }}){% if axis["physical_base"] != "0" %}){% endif %}[{% for position in range(axis["rank"]) %}{{ ":" if position == axis["physical_position"] else "None" }}{{ ", " if not loop.last else "" }}{% endfor %}]
{% for lane_extent in axis["lane_shape"] %}
{% set lane_axis = loop.index0 %}
{{ indent }}{{ axis["name"] }}_lane{{ lane_axis }} = tl.arange(0, {{ lane_extent }})[{% for position in range(axis["rank"]) %}{{ ":" if position == axis["physical_position"] + lane_axis + 1 else "None" }}{{ ", " if not loop.last else "" }}{% endfor %}]
{% endfor %}
{{ indent }}{{ axis["name"] }}_logical = {{ axis["logical_expression"] }}
{%- endmacro %}

{% macro matrix_shared_aliases(ctx, lhs_dtype, rhs_dtype, lhs_shape, rhs_shape, use_mma_layout) %}
    lhs_stage = tle.gpu.alloc({{ pyrepr(lhs_shape) }}, dtype={{ lhs_dtype }}, layout=None, scope=tle.gpu.smem, alias=pyntt_shared_arena, alias_offset_bytes={{ ctx["microkernel"]["shared_workspace_offsets"]["lhs_stage"] }}, nv_mma_shared_layout={{ "True" if use_mma_layout else "False" }})
    rhs_stage = tle.gpu.alloc({{ pyrepr(rhs_shape) }}, dtype={{ rhs_dtype }}, layout=None, scope=tle.gpu.smem, alias=pyntt_shared_arena, alias_offset_bytes={{ ctx["microkernel"]["shared_workspace_offsets"]["rhs_stage"] }}, nv_mma_shared_layout={{ "True" if use_mma_layout else "False" }})
{%- endmacro %}
