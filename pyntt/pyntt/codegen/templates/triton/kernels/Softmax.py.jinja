{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = softmax_context(model) %}
# generated from PyNTT Jinja Softmax.py.jinja
# {{ model["Comment"] }}; input_dtype={{ model["InputDType"] }}, output_dtype={{ model["OutputDType"] }}, shape={{ shape_tuple(model["Shape"]) }}, axis={{ model["Axis"] }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    input0 = {{ ptr(model, "Input") }}
    output = {{ ptr(model, "Output") }}
{% for axis in ctx["loop_axes"] %}
{{ "    " * loop.index }}for idx{{ axis }} in tl.range(0, {{ dim(model["Shape"][axis]) }}):
{% endfor %}
{% set body = "    " * ((ctx["loop_axes"] | length) + 1) %}
{{ body }}lane = tl.arange(0, {{ ctx["axis_block_size"] }})
{{ body }}mask = lane < {{ dim(ctx["axis_extent"]) }}
{{ body }}values = tl.load({{ access_pointer(model, "Input", "input0", ctx["input_access"]) }}, mask=mask, other=-float("inf")).to(tl.float32)
{{ body }}max_value = tl.max(values, axis=0)
{{ body }}numerator = tl.exp(values - max_value)
{{ body }}denominator = tl.sum(numerator, axis=0)
{{ body }}result = numerator / denominator
{{ body }}tl.store({{ access_pointer(model, "Output", "output", ctx["output_access"]) }}, result.to({{ model["OutputTritonDType"] }}), mask=mask)


{{ phases.dispatch(model) }}
