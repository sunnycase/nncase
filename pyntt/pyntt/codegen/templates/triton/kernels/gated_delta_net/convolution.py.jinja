{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% import "triton/kernels/_sum_partial.py.jinja" as partial_io with context %}
{% set ctx = gated_delta_net_convolution_context(model) %}
{% macro state_axis_offset(coordinate, axis) -%}
{% if axis["LaneCount"] == 1 -%}
({{ coordinate }}) * {{ axis["BlockStride"] }}
{%- else -%}
(({{ coordinate }}) // {{ axis["LaneCount"] }}) * {{ axis["BlockStride"] }} + (({{ coordinate }}) % {{ axis["LaneCount"] }}) * {{ axis["LaneStride"] }}
{%- endif %}
{%- endmacro %}
# generated from PyNTT algorithm triton.gated_delta_net/convolution
# {{ model["Comment"] }}; local_channels={{ ctx["local_n"] }}, global_channels={{ ctx["global_n"] }}, block_n={{ ctx["block_n"] }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    qkv = {{ ptr(model, "QKV") }}
    conv_state = {{ ptr(model, "ConvState") }}
    conv_weight = {{ ptr(model, "ConvWeight") }}
    qkv_output = {{ ptr(model, "QKVOutput") }}
    active_local_n = {{ model["ActiveLocalConvDim"] }}
    for channel_start in tl.range(0, {{ ctx["local_n"] }}, {{ ctx["block_n"] }}):
        channel = channel_start + tl.arange(0, {{ ctx["block_n"] }})
        global_channel = {{ pointer_local_vector_to_global_scalar_coordinate(model["QKVOutput"], 1, "channel", model["ActivationLaneCount"]) }}
        channel_mask = (channel < active_local_n) & (global_channel < {{ ctx["global_n"] }})
{% if ctx["qkv_partial"] %}
{{ partial_io.load(ctx["qkv_partial"], "current", "channel_mask", "        ") }}
{% else %}
        current = tl.load(
            {{ access_pointer(model, "QKV", "qkv", contiguous_vector_axis_access(["0", "0"], model["QKVStrides"], packed_axis=1, logical_index="channel", lane_count=model["ActivationLaneCount"])) }},
            mask=channel_mask,
            other=0.0,
        )
{% endif %}
        conv_state_base = (
            {{ state_axis_offset(model["LayerId"], model["ConvStateLayerAxis"]) }}
            + {{ state_axis_offset("global_channel", model["ConvStateChannelAxis"]) }}
        )
        convolved = current.to(tl.float32) * tl.load(
{% if ctx["weight_is_canonical_global"] %}
            {{ access_pointer(model, "ConvWeight", "conv_weight", tensor_access(["global_channel // " ~ model["ActivationLaneCount"], (model["ConvKernelSize"] - 1)|string], model["ConvWeightStrides"], ["global_channel % " ~ model["ActivationLaneCount"]], [model["ActivationLaneCount"]], global_coordinate_axes=[0])) }},
{% else %}
            {{ access_pointer(model, "ConvWeight", "conv_weight", tensor_access(["channel // " ~ model["ActivationLaneCount"], (model["ConvKernelSize"] - 1)|string], model["ConvWeightStrides"], ["channel % " ~ model["ActivationLaneCount"]], [model["ActivationLaneCount"]])) }},
{% endif %}
            mask=channel_mask,
            other=0.0,
        ).to(tl.float32)
{% for history in range(model["ConvKernelSize"] - 1) %}
        history{{ history }} = tl.load(
            conv_state + conv_state_base + {{ state_axis_offset(history|string, model["ConvStateHistoryAxis"]) }},
            mask=channel_mask,
            other=0.0,
        )
        convolved += history{{ history }}.to(tl.float32) * tl.load(
{% if ctx["weight_is_canonical_global"] %}
            {{ access_pointer(model, "ConvWeight", "conv_weight", tensor_access(["global_channel // " ~ model["ActivationLaneCount"], history|string], model["ConvWeightStrides"], ["global_channel % " ~ model["ActivationLaneCount"]], [model["ActivationLaneCount"]], global_coordinate_axes=[0])) }},
{% else %}
            {{ access_pointer(model, "ConvWeight", "conv_weight", tensor_access(["channel // " ~ model["ActivationLaneCount"], history|string], model["ConvWeightStrides"], ["channel % " ~ model["ActivationLaneCount"]], [model["ActivationLaneCount"]])) }},
{% endif %}
            mask=channel_mask,
            other=0.0,
        ).to(tl.float32)
{% endfor %}
{% for history in range(model["ConvKernelSize"] - 1) %}
        tl.store(
            conv_state + conv_state_base + {{ state_axis_offset(history|string, model["ConvStateHistoryAxis"]) }},
            {{ ("history" ~ (history + 1)) if history + 1 < model["ConvKernelSize"] - 1 else "current" }},
            mask=channel_mask,
        )
{% endfor %}
        convolved = convolved * tl.sigmoid(convolved)
        tl.store(
            {{ access_pointer(model, "QKVOutput", "qkv_output", contiguous_vector_axis_access(["0", "0"], model["QKVOutputStrides"], packed_axis=1, logical_index="channel", lane_count=model["ActivationLaneCount"])) }},
            convolved.to({{ model["ActivationTritonDType"] }}),
            mask=channel_mask,
        )


{{ phases.dispatch(model) }}
