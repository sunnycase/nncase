{{ "@triton.jit(noinline=True)" if model["NoInline"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__consumer(reader, {{ helper_parameters(model) }}):
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    input0 = {{ ptr(model, "Input") }}
    recurrent_state = {{ ptr(model, "RecurrentState") }}
    qkv = {{ ptr(model, "QKV") }}
    b_weight = {{ ptr(model, "BWeight") }}
    a_weight = {{ ptr(model, "AWeight") }}
    a_log = {{ ptr(model, "ALog") }}
    dt_bias = {{ ptr(model, "DtBias") }}
    norm_weight = {{ ptr(model, "NormWeight") }}
    gated_output = {{ ptr(model, "GatedOutput") }}
    activation_stage = tle.gpu.alloc(
        [{{ ctx["activation_elements"] }}],
        dtype={{ model["InputTritonDType"] }},
        layout=None,
        scope=tle.gpu.smem,
        alias=pyntt_shared_arena,
        alias_offset_bytes={{ microkernel["shared_workspace_offsets"]["activation_stage"] }},
    )
    qkv_stage = tle.gpu.alloc(
        [{{ model["QKVStageSize"] }}],
        dtype={{ model["InputTritonDType"] }},
        layout=None,
        scope=tle.gpu.smem,
        alias=pyntt_shared_arena,
        alias_offset_bytes={{ microkernel["shared_workspace_offsets"]["qkv_result_stage"] }},
    )
{% for name, dtype, size in (
    ("query", "tl.float32", model["KeyStageSize"]),
    ("key", "tl.float32", model["KeyStageSize"]),
) %}
    {{ name }}_stage = tle.gpu.alloc(
        [{{ size }}],
        dtype={{ dtype }},
        layout=None,
        scope=tle.gpu.smem,
        alias=pyntt_shared_arena,
        alias_offset_bytes={{ microkernel["shared_workspace_offsets"][name ~ "_stage"] }},
    )
{% endfor %}
    core_stage = tle.gpu.alloc(
        [{{ model["ValueBlockSize"] }}],
        dtype=tl.float32,
        layout=None,
        scope=tle.gpu.smem,
        alias=pyntt_shared_arena,
        alias_offset_bytes={{ microkernel["shared_workspace_offsets"]["qkv_result_stage"] }},
    )
    z_result_stage = tle.gpu.alloc(
        [{{ model["ValueBlockSize"] }}],
        dtype={{ model["InputTritonDType"] }},
        layout=None,
        scope=tle.gpu.smem,
        alias=pyntt_shared_arena,
        alias_offset_bytes=(
            {{ microkernel["shared_workspace_offsets"]["qkv_result_stage"] }}
            + {{ local_qkv_dim * 2 }}
        ),
    )

    for hidden_start in tl.range(0, {{ ctx["activation_elements"] }}, {{ ctx["block_k"] }}):
        hidden = hidden_start + tl.arange(0, {{ ctx["block_k"] }})
        hidden_mask = hidden < {{ ctx["hidden_size"] }}
        activation = tl.load(
            {{ access_pointer(model, "Input", "input0", tensor_access(["0", "hidden"], model["InputStrides"])) }},
            mask=hidden_mask,
            other=0.0,
        )
        tl.store(
            tle.gpu.local_ptr(
                activation_stage,
                (hidden,),
                shape=({{ ctx["block_k"] }},),
            ),
            activation,
        )

    for local_qkv_start in tl.range(0, {{ local_qkv_dim }}, 32):
        local_qkv = local_qkv_start + tl.arange(0, 32)
        local_qkv_mask = local_qkv < {{ local_qkv_dim }}
        local_head = local_qkv // {{ per_head_qkv }}
        component = local_qkv % {{ per_head_qkv }}
{% set global_head = pointer_local_to_global_coordinate(model["BWeight"], 1, "local_head") %}
        global_key_head = ({{ global_head }}) // {{ repeats }}
        global_qkv_channel = tl.where(
            component < {{ model["KeyHeadDim"] }},
            global_key_head * {{ model["KeyHeadDim"] }} + component,
            tl.where(
                component < {{ model["KeyHeadDim"] * 2 }},
                {{ model["NumKeyHeads"] * model["KeyHeadDim"] }} + global_key_head * {{ model["KeyHeadDim"] }} + component - {{ model["KeyHeadDim"] }},
                {{ model["NumKeyHeads"] * model["KeyHeadDim"] * 2 }} + ({{ global_head }}) * {{ model["ValueHeadDim"] }} + component - {{ model["KeyHeadDim"] * 2 }},
            ),
        )
        convolved = tl.load(
            {{ access_pointer(model, "QKV", "qkv", contiguous_vector_axis_access(["0", "0"], model["QKVStrides"], packed_axis=1, logical_index="global_qkv_channel", lane_count=model["QKVLaneCount"], global_coordinate_axes=[1])) }},
            mask=local_qkv_mask,
            other=0.0,
        )
        tl.store(
            tle.gpu.local_ptr(qkv_stage, (local_qkv,), shape=(32,)),
            convolved.to({{ model["InputTritonDType"] }}),
            mask=local_qkv_mask,
        )
    tl.debug_barrier()

    key_lane = tl.arange(0, {{ model["KeyBlockSize"] }})
    key_lane_mask = key_lane < {{ model["KeyHeadDim"] }}
    for local_head in tl.static_range(0, {{ model["LocalNumValueHeads"] }}):
        qkv_base = local_head * {{ per_head_qkv }}
        query_source = tl.load(
            tle.gpu.local_ptr(qkv_stage, (qkv_base + key_lane,), shape=({{ model["KeyBlockSize"] }},)),
            mask=key_lane_mask,
            other=0.0,
        ).to(tl.float32)
        key_source = tl.load(
            tle.gpu.local_ptr(qkv_stage, (qkv_base + {{ model["KeyHeadDim"] }} + key_lane,), shape=({{ model["KeyBlockSize"] }},)),
            mask=key_lane_mask,
            other=0.0,
        ).to(tl.float32)
        query_inv_norm = tl.rsqrt(tl.sum(query_source * query_source, axis=0) + 1.0e-6)
        key_inv_norm = tl.rsqrt(tl.sum(key_source * key_source, axis=0) + 1.0e-6)
        head_key_index = local_head * {{ model["KeyHeadDim"] }} + key_lane
        tl.store(
            tle.gpu.local_ptr(query_stage, (head_key_index,), shape=({{ model["KeyBlockSize"] }},)),
            query_source * query_inv_norm,
            mask=key_lane_mask,
        )
        tl.store(
            tle.gpu.local_ptr(key_stage, (head_key_index,), shape=({{ model["KeyBlockSize"] }},)),
            key_source * key_inv_norm,
            mask=key_lane_mask,
        )
    tl.debug_barrier()

    shared_k = tl.broadcast_to(
        tl.arange(0, {{ ctx["block_k"] }})[:, None],
        ({{ ctx["block_k"] }}, {{ ctx["block_n"] }}),
    )
    shared_n = tl.broadcast_to(
        tl.arange(0, {{ ctx["block_n"] }})[None, :],
        ({{ ctx["block_k"] }}, {{ ctx["block_n"] }}),
    )
    mma_k = tl.arange(0, {{ ctx["block_k"] }})
    for local_head in tl.static_range(0, {{ model["LocalNumValueHeads"] }}):
{% set global_head = pointer_local_to_global_coordinate(model["BWeight"], 1, "local_head") %}
        recurrent_state_head_base = (
            {{ state_axis_offset(model["LayerId"], model["RecurrentStateLayerAxis"]) }}
            + {{ state_axis_offset(global_head, model["RecurrentStateHeadAxis"]) }}
        )
        a_projection = 0.0
        b_projection = 0.0
        for hidden_start in tl.range(0, {{ ctx["activation_elements"] }}, {{ ctx["block_k"] }}):
            hidden_lane = hidden_start + tl.arange(0, {{ ctx["block_k"] }})
            hidden_mask = hidden_lane < {{ ctx["hidden_size"] }}
            hidden_value = tl.load(
                tle.gpu.local_ptr(activation_stage, (hidden_lane,), shape=({{ ctx["block_k"] }},)),
                mask=hidden_mask,
                other=0.0,
            ).to(tl.float32)
            a_projection += tl.sum(hidden_value * tl.load(
                {{ access_pointer(model, "AWeight", "a_weight", tensor_access(["hidden_lane", "local_head"], model["AWeightStrides"])) }},
                mask=hidden_mask,
                other=0.0,
            ).to(tl.float32), axis=0)
            b_projection += tl.sum(hidden_value * tl.load(
                {{ access_pointer(model, "BWeight", "b_weight", tensor_access(["hidden_lane", "local_head"], model["BWeightStrides"])) }},
                mask=hidden_mask,
                other=0.0,
            ).to(tl.float32), axis=0)
        a_bias = tl.load({{ access_pointer(model, "ALog", "a_log", tensor_access(["local_head"], model["ALogStrides"])) }}).to(tl.float32)
        dt_value = tl.load({{ access_pointer(model, "DtBias", "dt_bias", tensor_access(["local_head"], model["DtBiasStrides"])) }}).to(tl.float32)
        softplus_arg = a_projection + dt_value
        softplus_value = tl.maximum(softplus_arg, 0.0) + tl.log(1.0 + tl.exp(-tl.abs(softplus_arg)))
        decay = tl.exp(-tl.exp(a_bias) * softplus_value)
        beta = tl.sigmoid(b_projection)
        key_lane_local = tl.arange(0, {{ model["KeyBlockSize"] }})
        key_mask = key_lane_local < {{ model["KeyHeadDim"] }}
        key_value = tl.load(
            tle.gpu.local_ptr(
                key_stage,
                (key_lane_local,),
                shape=({{ model["KeyBlockSize"] }},),
            ),
            mask=key_mask,
            other=0.0,
        ).to(tl.float32)
        query_value = tl.load(
            tle.gpu.local_ptr(
                query_stage,
                (key_lane_local,),
                shape=({{ model["KeyBlockSize"] }},),
            ),
            mask=key_mask,
            other=0.0,
        ).to(tl.float32) * {{ pyrepr(1.0 / (model["KeyHeadDim"] ** 0.5)) }}
        key_query_dot = tl.sum(key_value * query_value, axis=0)
        head_square_sum = 0.0
        for n_tile in tl.range(0, {{ z_transfer["n_tiles"] }}):
            z_start = n_tile * {{ ctx["block_n"] }}
            z_index = z_start + tl.arange(0, {{ ctx["block_n"] }})
            z_mask = z_index < {{ ctx["local_value_dim"] }}
            z_acc = tle.encoding(
                tl.zeros(({{ ctx["block_m"] }}, {{ ctx["block_n"] }}), tl.float32),
                {{ model["FunctionName"] }}__mma_layout,
            )
            for state_tile_index in tl.range(0, {{ ctx["block_n"] // state_value_tile }}):
                state_tile_in_n = state_tile_index * {{ state_value_tile }}
                first_k_tile = state_tile_index * {{ z_k_tiles_per_state_tile }}
                for k_tile_in_state in tl.range(0, {{ z_k_tiles_per_state_tile }}):
                    k_tile = first_k_tile + k_tile_in_state
                    sequence = (
                        n_tile * {{ z_transfer["k_tiles"] }} + k_tile
                    ).to(tl.int32)
                    ready = reader.wait(sequence)
                    weight_ptr = tle.gpu.local_ptr(
                        ready.slot.weight,
                        (
{% for index in z_transfer["shared_k_indices"] %}
                            {{ index }},
{% endfor %}
{% for index in z_transfer["shared_n_indices"] %}
                            {{ index }},
{% endfor %}
                        ),
                        shape=({{ ctx["block_k"] }}, {{ ctx["block_n"] }}),
                    )
                    rhs = tle.encoding(
                        tl.load(weight_ptr),
                        {{ model["FunctionName"] }}__rhs_dot_layout,
                    )
                    activation = tl.load(
                        tle.gpu.local_ptr(
                            activation_stage,
                            (k_tile * {{ ctx["block_k"] }} + mma_k,),
                            shape=({{ ctx["block_k"] }},),
                        )
                    )
                    lhs = tle.encoding(
                        tl.broadcast_to(
                            activation[None, :],
                            ({{ ctx["block_m"] }}, {{ ctx["block_k"] }}),
                        ),
                        {{ model["FunctionName"] }}__lhs_dot_layout,
                    )
                    z_acc = tl.dot(lhs, rhs, acc=z_acc)
                    reader.release(sequence)

                value_lane = z_start + state_tile_in_n + tl.arange(0, {{ state_value_tile }})
                value_mask = value_lane < {{ model["ValueHeadDim"] }}
                state_mask = key_mask[:, None] & value_mask[None, :]
                state_value = tl.load(
                    recurrent_state
                    + recurrent_state_head_base
                    + {{ state_axis_offset("key_lane_local[:, None]", model["RecurrentStateKeyAxis"]) }}
                    + {{ state_axis_offset("value_lane[None, :]", model["RecurrentStateValueAxis"]) }},
                    mask=state_mask,
                    other=0.0,
                ).to(tl.float32) * decay
                recalled = tl.sum(state_value * key_value[:, None], axis=0)
                prior_read = tl.sum(state_value * query_value[:, None], axis=0)
                value_input = tl.load(
                    tle.gpu.local_ptr(
                        qkv_stage,
                        (
                            local_head * {{ per_head_qkv }}
                            + {{ model["KeyHeadDim"] * 2 }}
                            + value_lane,
                        ),
                        shape=({{ state_value_tile }},),
                    ),
                    mask=value_mask,
                    other=0.0,
                ).to(tl.float32)
                delta = (value_input - recalled) * beta
                updated = state_value + key_value[:, None] * delta[None, :]
                tl.store(
                    recurrent_state
                    + recurrent_state_head_base
                    + {{ state_axis_offset("key_lane_local[:, None]", model["RecurrentStateKeyAxis"]) }}
                    + {{ state_axis_offset("value_lane[None, :]", model["RecurrentStateValueAxis"]) }},
                    updated,
                    mask=state_mask,
                )
                core = prior_read + delta * key_query_dot
                local_value_index = local_head * {{ model["ValueHeadDim"] }} + value_lane
                tl.store(
                    tle.gpu.local_ptr(
                        core_stage,
                        (local_value_index,),
                        shape=({{ state_value_tile }},),
                    ),
                    core,
                    mask=value_mask,
                )
                head_square_sum += tl.sum(
                    tl.where(value_mask, core * core, 0.0),
                    axis=0,
                )
            tl.store(
                tle.gpu.local_ptr(
                    z_result_stage,
                    (z_index,),
                    shape=({{ ctx["block_n"] }},),
                ),
                (tl.sum(z_acc, axis=0) * (1.0 / {{ ctx["block_m"] }})).to({{ model["InputTritonDType"] }}),
                mask=z_mask,
            )
        inv_rms = tl.rsqrt(
            head_square_sum / {{ model["ValueHeadDim"] }}
            + {{ pyrepr(model["Epsilon"]) }}
        )
        tl.store(
            tle.gpu.local_ptr(query_stage, (local_head,), shape=(1,)),
            inv_rms,
        )

    tl.debug_barrier()
    for local_head in tl.static_range(0, {{ model["LocalNumValueHeads"] }}):
        inv_rms = tl.load(
            tle.gpu.local_ptr(query_stage, (local_head,), shape=(1,))
        )
        for value_start in tl.range(
            0,
            {{ model["ValueBlockSize"] }},
            {{ state_value_tile }},
        ):
            value_lane = value_start + tl.arange(0, {{ state_value_tile }})
            value_mask = value_lane < {{ model["ValueHeadDim"] }}
            local_value_index = local_head * {{ model["ValueHeadDim"] }} + value_lane
            core = tl.load(
                tle.gpu.local_ptr(
                    core_stage,
                    (local_value_index,),
                    shape=({{ state_value_tile }},),
                ),
                mask=value_mask,
                other=0.0,
            )
            z_projection = tl.load(
                tle.gpu.local_ptr(
                    z_result_stage,
                    (local_value_index,),
                    shape=({{ state_value_tile }},),
                ),
                mask=value_mask,
                other=0.0,
            ).to(tl.float32)
            scale = tl.load(
                {{ access_pointer(model, "NormWeight", "norm_weight", tensor_access(["value_lane"], model["NormWeightStrides"])) }},
                mask=value_mask,
                other=0.0,
            ).to(tl.float32)
            gated = core * inv_rms * scale * z_projection * tl.sigmoid(z_projection)
            tl.store(
                {{ access_pointer(model, "GatedOutput", "gated_output", tensor_access(["0", "local_value_index"], model["GatedOutputStrides"])) }},
                gated.to({{ model["OutputTritonDType"] }}),
                mask=value_mask,
            )
{% endif %}
