{% if model is defined %}
{% import "triton/kernels/_common.py.jinja" as common with context %}
{% set ctx = gated_delta_net_recurrent_core_pipeline_context(model, "recurrent_core_single_head_register_state_hybrid_tma_smem_pipeline") %}
{% set microkernel = ctx["microkernel"] %}
{% set z_transfer = ctx["z"] %}
{% set state_value_tile = ctx["state_value_tile"] %}
{% set z_k_tiles_per_state_tile = ctx["z_k_tiles_per_state_tile"] %}
{% set repeats = model["NumValueHeads"] // model["NumKeyHeads"] %}
{% set per_head_qkv = (2 * model["KeyHeadDim"]) + model["ValueHeadDim"] %}
{% set local_qkv_dim = model["LocalNumValueHeads"] * per_head_qkv %}
{% macro state_axis_offset(coordinate, axis) -%}
{% if axis["LaneCount"] == 1 -%}
({{ coordinate }}) * {{ axis["BlockStride"] }}
{%- else -%}
(({{ coordinate }}) // {{ axis["LaneCount"] }}) * {{ axis["BlockStride"] }} + (({{ coordinate }}) % {{ axis["LaneCount"] }}) * {{ axis["LaneStride"] }}
{%- endif %}
{%- endmacro %}
{% macro produce_matrix(transfer, sequence_base) %}
    for n_tile in tl.range(0, {{ transfer["n_tiles"] }}):
        for k_tile in tl.range(0, {{ transfer["k_tiles"] }}):
            sequence = (
                {{ sequence_base }}
                + n_tile * {{ transfer["k_tiles"] }}
                + k_tile
            ).to(tl.int32)
            slot = writer.acquire(sequence)
            descriptor = tle.gpu.reinterpret_tensor_map(
                {{ transfer["lower"] }}_descriptor_entry,
                slot.weight,
            )
            tle.gpu.copy(
                descriptor,
                slot.weight,
                [{{ transfer["shared_stage_shape"] | join(", ") }}],
                offsets=[
{% for offset in transfer["descriptor_offsets"] %}
                    {{ tma_offset(offset) }},
{% endfor %}
                ],
                eviction_policy="evict_first",
            )
            writer.commit(sequence)
{% endmacro %}
