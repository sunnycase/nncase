{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_elementwise.py.jinja" as elementwise with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = norm_stats_context(model) %}
# generated from PyNTT Jinja NormStats.py.jinja
# {{ model["Comment"] }}; input_dtype={{ model["InputDType"] }}, output_dtype={{ model["OutputDType"] }}, input_shape={{ shape_tuple(model["InputShape"]) }}, output_shape={{ shape_tuple(model["OutputShape"]) }}, axis={{ model["Axis"] }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    input0 = {{ ptr(model, "Input") }}
    output = {{ ptr(model, "Output") }}
{% for axis in ctx["outer_axes"] %}
{{ "    " * loop.index }}for outer_idx{{ axis }} in tl.range(0, {{ dim(ctx["logical_input_shape"][axis]) }}):
{% endfor %}
{% set base = "    " * ((ctx["outer_axes"] | length) + 1) %}
{% set body = "    " * ((ctx["outer_axes"] | length) + 2) %}
{% if model["UseMean"] %}
{{ base }}mean_partial = tl.zeros({{ ctx["tile_shape"] }}, tl.float32)
{% endif %}
{{ base }}square_partial = tl.zeros({{ ctx["tile_shape"] }}, tl.float32)
{% if ctx["flat_reduction"] %}
{{ base }}for reduction_start in tl.range(0, {{ ctx["reduction_extent"] }}, block_size, loop_unroll_factor=1):
{{ body }}reduction_offsets = reduction_start + tl.arange(0, block_size)
{{ body }}mask = reduction_offsets < {{ ctx["reduction_extent"] }}
{{ body }}value0 = tl.load({{ access_pointer(model, "Input", "input0", ctx["flat_input_base_access"]) }} + reduction_offsets, mask=mask, other=0.0).to(tl.float32)
{% if model["UseMean"] %}
{{ body }}mean_partial += value0
{% endif %}
{{ body }}square_partial += value0 * value0
{% else %}
{% call(body) elementwise.iterate(ctx, ctx["prefix_depth"]) %}
{{ body }}value0 = tl.load({{ access_pointer(model, "Input", "input0", ctx["input_access"]) }}, mask=mask, other=0.0).to(tl.float32)
{% if model["UseMean"] %}
{{ body }}mean_partial += value0
{% endif %}
{{ body }}square_partial += value0 * value0
{% endcall %}
{% endif %}
{% if model["UseMean"] %}
{{ base }}tl.store({{ access_pointer(model, "Output", "output", ctx["stats_accesses"][0]) }}, {{ ctx["reduction"] }}, mask=True)
{{ base }}tl.store({{ access_pointer(model, "Output", "output", ctx["stats_accesses"][1]) }}, {{ ctx["square_reduction"] }}, mask=True)
{% else %}
{{ base }}tl.store({{ access_pointer(model, "Output", "output", ctx["stats_accesses"][0]) }}, {{ ctx["square_reduction"] }}, mask=True)
{% endif %}


{{ phases.dispatch(model) }}
