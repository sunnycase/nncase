@triton.jit
def {{ model["FunctionName"] }}__producer(writer, {{ helper_parameters(model) }}):
    shard_index = tl.program_id(0).to(tl.int64)
    for n_tile in tl.static_range(0, {{ ctx["num_n_tiles"] }}):
        n_start = n_tile * {{ ctx["block_n"] }}
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            slot = writer.acquire(sequence)
            for n_chunk in tl.static_range(0, {{ ctx["copies_per_tile"] }}):
                copy_global_n = n_start + n_chunk * {{ ctx["copy_n"] }}
{% if ctx["copy_is_full_stage"] %}
                copy_destination = slot.weight
{% else %}
                copy_destination = slot.weight.subslice(
                    [n_chunk * {{ ctx["copy_n_outer"] }}, 0, 0, 0],
                    [{{ ctx["copy_shape"] | join(", ") }}],
                )
{% endif %}
{% for projection in ctx["projections"] %}
                {{ "if" if loop.first else "elif" }} (
                    copy_global_n >= {{ projection["projection_start"] }}
                    and copy_global_n < {{ projection["copy_end"] }}
                ):
                    descriptor_k = (
                        {{ dim(projection["descriptor_global_k_outer_offset"]) }}
                        + k_tile * {{ ctx["packed_k_outer"] }}
                    ).to(tl.int32)
                    descriptor_n = (
                        {{ dim(projection["descriptor_global_n_outer_offset"]) }}
                        + (
                            copy_global_n
                            - {{ projection["projection_start"] }}
                        ) // {{ model["NVectorLaneCount"] }}
                    ).to(tl.int32)
                    tle.gpu.copy(
                        {{ projection["descriptor_name"] }},
                        copy_destination,
                        [{{ ctx["copy_shape"] | join(", ") }}],
                        offsets=[
                            descriptor_n,
                            descriptor_k,
                            0,
                            0,
                        ],
                    )
{% endfor %}
            writer.commit(sequence)


@triton.jit
def {{ model["FunctionName"] }}__consumer(reader, {{ helper_parameters(model) }}):
    shard_index = tl.program_id(0).to(tl.int64)
{% set pointer_keys = namespace(values=[model["Input"], model["QOutput"], model["KOutput"], model["VOutput"]]) %}
{% for prefix in ("Q", "K", "V") %}
{% if model["Has" ~ prefix ~ "Bias"] %}{% do pointer_keys.values.append(model[prefix ~ "Bias"]) %}{% endif %}
{% endfor %}
{{ common.shard_coordinates(pointer_keys.values) }}
    input0 = {{ ptr(model, "Input") }}
{% for prefix in ("Q", "K", "V") %}
{% if model["Has" ~ prefix ~ "Bias"] %}
    {{ prefix | lower }}_bias = {{ ptr(model, prefix ~ "Bias") }}
{% endif %}
    {{ prefix | lower }}_output = {{ ptr(model, prefix ~ "Output") }}
{% endfor %}
    local_n = tle.encoding(
        tle.encoding(
            tl.arange(0, {{ ctx["block_n"] }}),
            {{ ctx["consumer_output_layout_name"] }},
        )[:, None],
        {{ ctx["consumer_weight_layout_name"] }},
    )
    local_k_vector = tle.encoding(
        tl.arange(0, {{ ctx["reduction_group"] }}),
        {{ ctx["consumer_lhs_layout_name"] }},
    )
    local_k = tle.encoding(
        local_k_vector[None, :],
        {{ ctx["consumer_weight_layout_name"] }},
    )
    for n_tile in tl.static_range(0, {{ ctx["num_n_tiles"] }}):
        n_start = n_tile * {{ ctx["block_n"] }}
        partial = tle.encoding(
            tl.zeros(
                ({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}),
                tl.float32,
            ),
            {{ ctx["consumer_weight_layout_name"] }},
        )
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            ready = reader.wait(sequence)
            for k_group in tl.static_range(0, {{ ctx["reduction_groups_per_stage"] }}):
                shared_k = k_group * {{ ctx["reduction_group"] }} + local_k
                shared_payload = (
                    local_n % {{ model["NVectorLaneCount"] }}
                    * {{ ctx["k_atom"] }}
                    + shared_k % {{ ctx["k_atom"] }}
                )
                weight_ptr = tle.gpu.local_ptr(
                    ready.slot.weight,
                    (
                        local_n // {{ model["NVectorLaneCount"] }},
                        shared_k // {{ ctx["k_atom"] }},
                        shared_payload // {{ ctx["tma_contiguous_extent"] }},
                        shared_payload % {{ ctx["tma_contiguous_extent"] }},
                    ),
                    shape=({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}),
                )
                weight_ptr = tl.max_contiguous(weight_ptr, [1, 8])
                weight_ptr = tl.multiple_of(weight_ptr, [1, 16])
                pipeline_offs_k = (
                    k_tile * {{ ctx["block_k"] }}
                    + k_group * {{ ctx["reduction_group"] }}
                    + local_k_vector
                )
                weight_value = tle.encoding(
                    tl.load(weight_ptr),
                    {{ ctx["consumer_weight_layout_name"] }},
                )
                input_value = tle.encoding(
                    tl.load(
                        {{ access_pointer(model, "Input", "input0", ctx["pipeline_input_access"]) }}
                    ),
                    {{ ctx["consumer_lhs_layout_name"] }},
                )
                input_value = tle.encoding(
                    input_value[None, :],
                    {{ ctx["consumer_weight_layout_name"] }},
                )
                partial += weight_value.to(tl.float32) * input_value.to(tl.float32)
            reader.release(sequence)

        result = tl.sum(partial, axis=1)
        pipeline_output_n = n_start + tle.encoding(
            tl.arange(0, {{ ctx["block_n"] }}),
            {{ ctx["consumer_output_layout_name"] }},
        )
{% for projection in ctx["projections"] %}
        {{ projection["projection_n_expr"] }} = (
            pipeline_output_n - {{ projection["projection_start"] }}
        )
{% if projection["has_bias"] %}
        {{ projection["lower"] }}_bias_value = tl.load(
            {{ access_pointer(model, projection["prefix"] ~ "Bias", projection["lower"] ~ "_bias", projection["bias_access"]) }},
            mask={{ projection["projection_mask"] }},
            other=0.0,
        ).to(tl.float32)
        result += {{ projection["lower"] }}_bias_value
{% endif %}
        tl.store(
            {{ access_pointer(model, projection["prefix"] ~ "Output", projection["lower"] ~ "_output", projection["output_access"]) }},
            result,
            mask={{ projection["projection_mask"] }},
        )
{% endfor %}


