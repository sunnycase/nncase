{% macro pipeline_setup(stage) -%}
{% set stage_model = stage["Model"] %}
{% set stage_ctx = packed_qkv_gemv_pipeline_context(stage_model) %}
{% set shared_buffer_shape = [stage_ctx["num_stages"]] + (stage_ctx["shared_stage_shape"] | list) %}
{{ stage["StageName"] }}__rhs_stages = tle.gpu.alloc(
    [{{ shared_buffer_shape | join(", ") }}],
    dtype={{ stage_model["WeightTritonDType"] }},
    layout=tle.gpu.nv_tma_shared_layout(
        [{{ shared_buffer_shape | join(", ") }}],
        [{{ range((shared_buffer_shape | length) - 1, -1, -1) | join(", ") }}],
        {{ stage_model["WeightTritonDType"] }},
        [{% for _ in shared_buffer_shape %}1{{ ", " if not loop.last }}{% endfor %}],
        [{% for _ in shared_buffer_shape %}1{{ ", " if not loop.last }}{% endfor %}],
        [{{ range((shared_buffer_shape | length) - 1, -1, -1) | join(", ") }}],
        False,
        True,
    ),
    scope=tle.gpu.smem,
    alias=pyntt_shared_arena,
    alias_offset_bytes={{ stage["SharedWorkspaceOffsets"]["rhs_stage"] }},
)
{% set lhs_workspace = stage["ConsumerSharedWorkspaces"][0] %}
{{ lhs_workspace["VariableName"] }} = tle.gpu.alloc(
    [1, {{ stage_ctx["block_k"] }}],
    dtype={{ stage_model["InputTritonDType"] }},
    layout=None,
    scope=tle.gpu.smem,
    alias=pyntt_shared_arena,
    alias_offset_bytes={{ lhs_workspace["SharedWorkspaceOffset"] }},
    nv_mma_shared_layout=True,
)
{{ stage["PipeName"] }} = tle.pipe(
    capacity={{ stage_ctx["num_stages"] }},
    scope="cta",
    name="{{ stage["StageName"] }}_weight",
    weight={{ stage["StageName"] }}__rhs_stages,
)
{%- endmacro %}
{% if model is defined %}
{% import "triton/kernels/_common.py.jinja" as common with context %}
{% set ctx = packed_qkv_gemv_pipeline_context(model) %}
# generated from PyNTT algorithm triton.qkv_parallel_linear/simt_fma_smem_pipeline
# {{ model["Comment"] }}; input_dtype={{ model["InputDType"] }}, weight_dtype={{ model["WeightDType"] }}, output_dtype={{ model["OutputDType"] }}, input_shape={{ shape_tuple(model["InputShape"]) }}, weight_shape={{ shape_tuple(model["WeightShape"]) }}, projection_n_capacities={{ model["ProjectionNCapacities"] }}, q_output_shape={{ shape_tuple(model["QOutputShape"]) }}, k_output_shape={{ shape_tuple(model["KOutputShape"]) }}, v_output_shape={{ shape_tuple(model["VOutputShape"]) }}, rhs_layout={{ model["RhsLayout"] }}, n_lane={{ model["NVectorLaneCount"] }}, k_pack={{ model["KPackLaneCount"] }}, k_lane={{ model["KVectorLaneCount"] }}, block_n={{ ctx["block_n"] }}, block_k={{ ctx["block_k"] }}, num_stages={{ ctx["num_stages"] }}
{{ ctx["consumer_weight_layout_name"] }} = tl.constexpr(
    tle.gpu.BlockEncoding(
        [{{ ctx["consumer_size_per_thread"] | join(", ") }}],
        [{{ ctx["consumer_threads_per_warp"] | join(", ") }}],
        [{{ ctx["consumer_warps_per_cta"] | join(", ") }}],
        [0, 1],
    )
)
{{ ctx["consumer_lhs_layout_name"] }} = tl.constexpr(
    tle.gpu.SlicedEncoding(
        0,
        {{ ctx["consumer_weight_layout_name"] }}.value,
    )
)
{{ ctx["consumer_output_layout_name"] }} = tl.constexpr(
    tle.gpu.SlicedEncoding(
        1,
        {{ ctx["consumer_weight_layout_name"] }}.value,
    )
)
{{ ctx["consumer_input_copy_layout_name"] }} = tl.constexpr(
    tle.gpu.BlockEncoding(
        [1, {{ ctx["input_copy_size_per_thread"] }}],
        [1, {{ model["TargetWorkerWidth"] }}],
        [1, {{ model["NumWarps"] }}],
        [0, 1],
    )
)


{{ "@triton.jit(noinline=True)" if model["NoInline"] or ctx["outline_consumer_stage"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__consumer_stage(weight_stage, lhs_stage):
    local_n = tle.encoding(
        tle.encoding(
            tl.arange(0, {{ ctx["block_n"] }}),
            {{ ctx["consumer_output_layout_name"] }},
        )[:, None],
        {{ ctx["consumer_weight_layout_name"] }},
    )
    local_k_vector = tle.encoding(
        tl.arange(0, {{ ctx["reduction_group"] }}),
        {{ ctx["consumer_lhs_layout_name"] }},
    )
    local_k = tle.encoding(
        local_k_vector[None, :],
        {{ ctx["consumer_weight_layout_name"] }},
    )
    input_row_vector = tle.encoding(
        tl.zeros(({{ ctx["reduction_group"] }},), tl.int32),
        {{ ctx["consumer_lhs_layout_name"] }},
    )
    partial = tle.encoding(
        tl.zeros(
            ({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}),
            tl.float32,
        ),
        {{ ctx["consumer_weight_layout_name"] }},
    )
    for k_group in tl.static_range(0, {{ ctx["reduction_groups_per_stage"] }}):
        shared_k = k_group * {{ ctx["reduction_group"] }} + local_k
        shared_payload = (
            local_n % {{ model["NVectorLaneCount"] }}
            * {{ ctx["k_atom"] }}
            + shared_k % {{ ctx["k_atom"] }}
        )
        weight_ptr = tle.gpu.local_ptr(
            weight_stage,
            (
{% for index in ctx["shared_weight_indices"] %}
                tle.encoding(
                    {{ index }},
                    {{ ctx["consumer_weight_layout_name"] }},
                ),
{% endfor %}
            ),
            shape=({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}),
        )
        weight_ptr = tl.max_contiguous(weight_ptr, [1, 8])
        weight_ptr = tl.multiple_of(weight_ptr, [1, 16])
        weight_value = tle.encoding(
            tl.load(weight_ptr),
            {{ ctx["consumer_weight_layout_name"] }},
        )
        input_ptr = tle.gpu.local_ptr(
            lhs_stage,
            (
                input_row_vector,
                k_group * {{ ctx["reduction_group"] }} + local_k_vector,
            ),
        )
        input_value = tle.encoding(
            tl.load(input_ptr),
            {{ ctx["consumer_lhs_layout_name"] }},
        )
        input_value = tle.encoding(
            input_value[None, :],
            {{ ctx["consumer_weight_layout_name"] }},
        )
        partial += weight_value.to(tl.float32) * input_value.to(tl.float32)
    return partial


{{ "@triton.jit(noinline=True)" if model["NoInline"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__producer(writer, {{ helper_parameters(model) }}):
{{ common.mesh_coordinates(model["MeshAxes"]) }}
    weight_descriptor_entry = tle.gpu.tensor_map_table_entry(
        {{ ctx["descriptor_name"] }},
        shard_index,
    )
    tle.gpu.tensor_map_fenceproxy_acquire(
        weight_descriptor_entry
    )
    for n_tile in tl.static_range(
        0,
        {{ ctx["num_n_tiles"] }},
    ):
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            slot = writer.acquire(sequence)
            weight_descriptor = tle.gpu.reinterpret_tensor_map(
                weight_descriptor_entry,
                slot.weight,
            )
            tle.gpu.copy(
                weight_descriptor,
                slot.weight,
                [{{ ctx["shared_stage_shape"] | join(", ") }}],
                offsets=[
{% for offset in ctx["descriptor_offsets"] %}
                    {{ tma_offset(offset) }},
{% endfor %}
                ],
                eviction_policy="evict_first",
            )
            writer.commit(sequence)
    writer.close({{ ctx["num_n_tiles"] * ctx["num_k_tiles"] }})


{{ "@triton.jit(noinline=True)" if model["NoInline"] else "@triton.jit" }}
def {{ model["FunctionName"] }}__consumer(reader, lhs_stage, {{ helper_parameters(model) }}):
{{ common.mesh_coordinates(model["MeshAxes"]) }}
{% set pointer_keys = namespace(values=[model["Input"], model["QOutput"], model["KOutput"], model["VOutput"]]) %}
{% for prefix in ("Q", "K", "V") %}
{% if model["Has" ~ prefix ~ "Bias"] %}{% do pointer_keys.values.append(model[prefix ~ "Bias"]) %}{% endif %}
{% endfor %}
    input0 = {{ ptr(model, "Input") }}
{% for prefix in ("Q", "K", "V") %}
{% if model["Has" ~ prefix ~ "Bias"] %}
    {{ prefix | lower }}_bias = {{ ptr(model, prefix ~ "Bias") }}
{% endif %}
    {{ prefix | lower }}_output = {{ ptr(model, prefix ~ "Output") }}
{% endfor %}
    local_n_source = tl.arange(0, {{ ctx["block_n"] }})
    input_copy_offset = tle.encoding(
        tl.arange(0, {{ ctx["block_k"] }})[None, :],
        {{ ctx["consumer_input_copy_layout_name"] }},
    )
    for n_tile in tl.range(
        0,
        {{ ctx["num_n_tiles"] }},
        loop_unroll_factor=1,
    ):
        n_start = n_tile * {{ ctx["block_n"] }}
        partial = tle.encoding(
            tl.zeros(
                ({{ ctx["block_n"] }}, {{ ctx["reduction_group"] }}),
                tl.float32,
            ),
            {{ ctx["consumer_weight_layout_name"] }},
        )
        for k_tile in tl.range(0, {{ ctx["num_k_tiles"] }}):
            sequence = (
                n_tile * {{ ctx["num_k_tiles"] }} + k_tile
            ).to(tl.int32)
            pipeline_input_copy_k = (
                k_tile * {{ ctx["block_k"] }} + input_copy_offset
            )
            tle.gpu.copy(
                {{ access_pointer(model, "Input", "input0", ctx["pipeline_input_copy_access"]) }},
                lhs_stage,
                [1, {{ ctx["block_k"] }}],
                is_async=True,
                eviction_policy="evict_last",
            )
            tle.gpu.async_commit_group()
            ready = reader.wait(sequence)
            tle.gpu.async_wait_group(0)
            tl.debug_barrier()
            partial += {{ model["FunctionName"] }}__consumer_stage(
                ready.slot.weight,
                lhs_stage,
            )
            reader.release(sequence)
            tl.debug_barrier()

        result = tl.sum(partial, axis=1)
        pipeline_output_n = n_start + tle.encoding(
            local_n_source,
            {{ ctx["consumer_output_layout_name"] }},
        )
{% for projection in ctx["projections"] %}
        {{ projection["projection_n_expr"] }} = (
            pipeline_output_n - {{ projection["projection_start"] }}
        )
{% if projection["has_bias"] %}
        {{ projection["lower"] }}_bias_value = tl.load(
            {{ access_pointer(model, projection["prefix"] ~ "Bias", projection["lower"] ~ "_bias", projection["bias_access"]) }},
            mask={{ projection["projection_mask"] }},
            other=0.0,
        ).to(tl.float32)
        result += {{ projection["lower"] }}_bias_value
{% endif %}
        tl.store(
            {{ access_pointer(model, projection["prefix"] ~ "Output", projection["lower"] ~ "_output", projection["output_access"]) }},
            result,
            mask={{ projection["projection_mask"] }},
        )
{% endfor %}


{% endif %}
