{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_elementwise.py.jinja" as elementwise with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = rope_context(model) %}
# generated from PyNTT Jinja RoPE.py.jinja
# {{ model["Comment"] }}; input_dtype={{ model["InputDType"] }}, cos_dtype={{ model["CosDType"] }}, sin_dtype={{ model["SinDType"] }}, output_dtype={{ model["OutputDType"] }}, shape={{ shape_tuple(model["OutputShape"]) }}, rotary_axis={{ ctx["rotary_axis"] }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
{% for name, key in (("input0", "Input"), ("cos0", "Cos"), ("sin0", "Sin"), ("output", "Output")) %}
    {{ name }} = {{ ptr(model, key) }}
{% endfor %}
{% call(indent) elementwise.iterate(ctx) %}
{{ indent }}rotary_mask = mask & ({{ ctx["is_rotary"] }})
{{ indent }}logical_rotary = {{ ctx["logical_rotary"] }}
{{ indent }}value0 = tl.load({{ access_pointer(model, "Input", "input0", ctx["input_access"]) }}, mask=mask, other=0.0).to(tl.float32)
{{ indent }}paired_value = tl.load({{ access_pointer(model, "Input", "input0", ctx["paired_input_access"]) }}, mask=rotary_mask, other=0.0).to(tl.float32)
{{ indent }}cos_value = tl.load({{ access_pointer(model, "Cos", "cos0", ctx["cos_access"]) }}, mask=rotary_mask, other=0.0).to(tl.float32)
{{ indent }}sin_value = tl.load({{ access_pointer(model, "Sin", "sin0", ctx["sin_access"]) }}, mask=rotary_mask, other=0.0).to(tl.float32)
{{ indent }}rotated = tl.where({{ ctx["first_half"] }}, -paired_value, paired_value)
{{ indent }}rotary_result = value0 * cos_value + rotated * sin_value
{{ indent }}result = tl.where({{ ctx["is_rotary"] }}, rotary_result, value0)
{{ indent }}tl.store({{ access_pointer(model, "Output", "output", ctx["output_access"]) }}, result, mask=mask)
{% endcall %}


{{ phases.dispatch(model) }}
