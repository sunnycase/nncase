{% import "triton/kernels/_common.py.jinja" as common with context %}
{% import "triton/kernels/_elementwise.py.jinja" as elementwise with context %}
{% import "triton/kernels/_producer_consumer.py.jinja" as phases with context %}
{% set ctx = gather_context(model) %}
# generated from PyNTT Jinja Gather.py.jinja
# {{ model["Comment"] }}; input_dtype={{ model["InputDType"] }}, index_dtype={{ model["IndexDType"] }}, output_dtype={{ model["OutputDType"] }}, input_shape={{ shape_tuple(model["InputShape"]) }}, output_shape={{ shape_tuple(model["OutputShape"]) }}, axis={{ model["Axis"] }}
{{ phases.consumer_header(model) }}
{{ common.mesh_coordinates(model["MeshAxes"]) }}
{% for name, key in (("input", "Input"), ("index", "Index"), ("output", "Output")) %}
    {{ name }} = {{ ptr(model, key) }}
{% endfor %}
{% call(indent) elementwise.iterate(ctx) %}
{{ indent }}gather_index = tl.load({{ access_pointer(model, "Index", "index", ctx["index_access"]) }}, mask={{ access_boundary_mask(ctx["index_access"]) }}, other=0)
{% if ctx["signed_index"] %}
{{ indent }}gather_index = tl.where(gather_index < 0, gather_index + {{ dim(model["InputGlobalShape"][model["Axis"]]) }}, gather_index)
{% endif %}
{{ indent }}input_active = (gather_index >= 0) & (gather_index < {{ dim(model["InputGlobalShape"][model["Axis"]]) }})
{{ indent }}local_gather_index = {{ ctx["local_gather_index"] }}
{{ indent }}input_active = input_active & ({{ ctx["input_owner_active"] }})
{{ indent }}value = tl.load({{ access_pointer(model, "Input", "input", ctx["input_access"]) }}, mask=mask & input_active, other=0.0)
{{ indent }}tl.store({{ access_pointer(model, "Output", "output", ctx["output_access"]) }}, value, mask=mask)
{% endcall %}


{{ phases.dispatch(model) }}
