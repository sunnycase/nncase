        [
            (
                {{ model["FunctionName"] }}__consumer,
                ({{ helper_argument_names(model, args) }},),
            ),
            (
                {{ model["FunctionName"] }}__producer,
                (),
            ),
        ],
        [{{ model["ProducerWarps"] }}],
        [{{ model["ProducerRegisters"] }}],
    )
{%- endmacro %}
