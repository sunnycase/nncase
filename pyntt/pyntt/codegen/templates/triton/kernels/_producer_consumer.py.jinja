{%- endmacro %}

{% macro dispatch(model, args=[]) -%}
@triton.jit
def {{ model["FunctionName"] }}__producer():
    pass


@triton.jit
def {{ model["FunctionName"] }}({{ helper_parameters(model, args) }}):
