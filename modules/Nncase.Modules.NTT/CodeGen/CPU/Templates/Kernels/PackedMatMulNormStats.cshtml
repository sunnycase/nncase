@model Nncase.CodeGen.NTT.TypedKernelTemplateModel<Nncase.TIR.NTT.PackedMatMulNormStats>
@{
  string lhs = Model.Arguments[0].Symbol.Name;
  string rhs = Model.Arguments[1].Symbol.Name;
  string output = Model.Arguments[2].Symbol.Name;
  string stats = Model.Arguments[3].Symbol.Name;
  string loadC = Model.Arguments[4].Symbol.Name;
  string scale = Model.Arguments[5].Symbol.Name;
  string addend = Model.Arguments[6].Symbol.Name;
}
@Html.Raw($"{Model.Indent}packed_matmul_norm_stats<{Model.Target.UseMean.ToString().ToLowerInvariant()}, {Model.Target.Axis}>({lhs}, {rhs}, {output}, {stats}, {loadC}, {scale}, {addend});\n")
