@model Nncase.CodeGen.NTT.TypedKernelTemplateModel<Nncase.TIR.NTT.PackedMatMul>
@{
  string scale = Model.Arguments[4].Symbol.Name;
  string addend = Model.Arguments[5].Symbol.Name;
  bool hasAddend = addend != "nullptr";
  string MatmulLine(bool accumulate, string output, string indent) =>
      $"{Model.Indent}{indent}packed_matmul<{accumulate.ToString().ToLowerInvariant()}>({Model.Arguments[0].Symbol.Name}, {Model.Arguments[1].Symbol.Name}, {output}, {scale});\n";
  string InitialMatmulLines(string output, string indent) => hasAddend
      ? $"{Model.Indent}{indent}cast({addend}, {output}, fixed_shape_v<>);\n{MatmulLine(true, output, indent)}"
      : MatmulLine(false, output, indent);
}

@if (Model.Reduction is { Phase: Nncase.CodeGen.NTT.ReductionKernelPhase.Accumulate } accumulate)
{
@Html.Raw($"{Model.Indent}{{\n")
@Html.Raw($"{Model.Indent}  if ({accumulate.Initialized}) {{\n")
@Html.Raw(MatmulLine(true, accumulate.Accumulators[0], "    "))
@Html.Raw($"{Model.Indent}  }} else {{\n")
@Html.Raw(InitialMatmulLines(accumulate.Accumulators[0], "    "))
@Html.Raw($"{Model.Indent}    {accumulate.Initialized} = true;\n")
@Html.Raw($"{Model.Indent}  }}\n")
@Html.Raw($"{Model.Indent}}}\n")
}
else if (Model.Reduction is { Phase: Nncase.CodeGen.NTT.ReductionKernelPhase.Finalize } finalize)
{
@Html.Raw($"{Model.Indent}cast({finalize.Accumulators[0]}, {Model.Arguments[2].Symbol.Name}, fixed_shape_v<>);\n")
}
else
{
@Html.Raw($"{Model.Indent}{{\n")
@if (Model.Arguments[3].Symbol.Name != "nullptr")
{
@Html.Raw($"{Model.Indent}  if ({Model.Arguments[3].Symbol.Name}) {{\n")
@Html.Raw(MatmulLine(true, Model.Arguments[2].Symbol.Name, "    "))
@Html.Raw($"{Model.Indent}  }} else {{\n")
@Html.Raw(InitialMatmulLines(Model.Arguments[2].Symbol.Name, "    "))
@Html.Raw($"{Model.Indent}  }}\n")
}
else
{
@Html.Raw(InitialMatmulLines(Model.Arguments[2].Symbol.Name, "  "))
}
@Html.Raw($"{Model.Indent}}}\n")
}
