@model Nncase.CodeGen.NTT.TypedKernelTemplateModel<Nncase.TIR.NTT.Reduce>
@{
  string input = Model.Arguments[0].Symbol.Name;
  string output = Model.Arguments[1].Symbol.Name;
  string initialize = Model.Arguments[2].Symbol.Name;
}
@Html.Raw($"{Model.Indent}reduce_kernel<reduce_op::{Model.Target.ReduceOp.ToC()}>({input}, {output}, {initialize}, fixed_shape_v<{string.Join(",", Model.Target.Axes)}>, fixed_shape_v<{string.Join(",", Model.Target.VectorizedAxes)}>, fixed_shape_v<{string.Join(",", Model.Target.PadedNums)}>);\n")
