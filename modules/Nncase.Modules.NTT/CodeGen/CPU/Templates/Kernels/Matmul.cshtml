@model Nncase.CodeGen.NTT.TypedKernelTemplateModel<Nncase.TIR.NTT.Matmul>
@{
  string lhs = Model.Arguments[0].Symbol.Name;
  string rhs = Model.Arguments[1].Symbol.Name;
  string output = Model.Arguments[2].Symbol.Name;
  string initialize = Model.Arguments[3].Symbol.Name;
  string scale = Model.Arguments[4].Symbol.Name;
}
@Html.Raw($"{Model.Indent}matmul_kernel<{Model.Target.TransposeA.ToString().ToLowerInvariant()}, {Model.Target.TransposeB.ToString().ToLowerInvariant()}>({lhs}, {rhs}, {output}, {initialize}, {scale}, fixed_shape_v<{string.Join(",", Model.Target.LhsVectorizedAxes)}>, fixed_shape_v<{string.Join(",", Model.Target.RhsVectorizedAxes)}>);\n")
