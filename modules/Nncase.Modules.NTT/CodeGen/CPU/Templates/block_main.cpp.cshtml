@using System.Linq
@using NetFabric.Hyperlinq
@using Nncase
@using Nncase.IR
@model Nncase.CodeGen.NTT.KernelMainModel
@{
  var abi = Model.EntryAbi;
  var inputCount = abi.Abi.Inputs.Count;
  var shardCount = TensorUtilities.GetProduct(Model.Options.Hierarchies[0]);
}

extern "C" NTT_DEVICE void @(Model.EntryPoint)(const nncase::ntt::runtime::block_inout_desc *input_descs,
  nncase::ntt::runtime::block_inout_desc *const output_descs,
  const std::byte *rdata,
  const std::byte *block_local_rdata,
  std::byte *data,
  std::byte *block_local_data,
  std::byte *output) {
  /* prepare inputs */
  @{
    var names = new List<string>();
  }
  @foreach(var (input,i) in abi.Abi.Inputs.Select((input,i)=>(input,i)))
  {
    var name = IRHelpers.GetIdentityName(input.Name);
    if (input is DimVar)
    {
      names.Add(name);
  @:int64_t @Html.Raw(name) = *(int64_t *)input_descs[@i].data;
    }
    else
    {
      names.Add(name);
      var shape = input.CheckedShape;
      var rank = shape.Rank;
      var sizeStr = $"input_descs[{i}].size / {input.CheckedDataType.SizeInBytes}";
      var elemType = input.CheckedDataType.ToC();
      var elementQualifier = input is Nncase.TIR.BufferVar { Role: Nncase.TIR.BufferVarRole.InOut }
        ? string.Empty
        : "const ";
      var qualifiedElemType = elementQualifier + elemType;
      var dimStr = $"make_shape({string.Join(", ", Enumerable.Range(0, rank).Select(d => shape[d].IsFixed ? $"{shape[d].FixedValue}_dim" : $"input_descs[{i}].shape[{d}]"))})";
      var strideStr = $"make_strides({string.Join(", ", Enumerable.Range(0, rank).Select(d => $"input_descs[{i}].strides[{d}]"))})";
      if (input.CheckedDataType is ReferenceType referenceType) {
        if (referenceType.ElemType is Nncase.IR.Heterogeneous.PipelineChannelType) {
  @:auto @(name) = reinterpret_cast<runtime::pipeline_channel *>(input_descs[@i].data);
        }
        else if (referenceType.ElemType is Nncase.IR.NN.PagedAttentionKVCacheType kvcacheType) {
          var size = TensorUtilities.GetProduct(shape.ToValueArray()); // todo: support dynamic shape
          var kv_tensor_shape = kvcacheType.Config.AxisPolicies.Select(p => p.HierarchyAxes.Select(i => Model.Options.Hierarchies[0][i]).Product()).ToArray();
          var kv_tensor_size = kv_tensor_shape.Product();
          if (kv_tensor_size > 128) {
            throw new NotSupportedException("KVCache tensor size is too large!");
          }
          var placement = new Placement(Model.Options.Hierarchies[0], Model.Options.HierarchyNames, Model.Options.HierarchyLevels);

  @:std::span<runtime::block_paged_attention_kv_cache_desc> p@(name)_descs((runtime::block_paged_attention_kv_cache_desc*)input_descs[@i].data, input_descs[@i].size / sizeof(runtime::block_paged_attention_kv_cache_desc));
  @:using paged_attention_kv_cache_mesh_t = @Html.Raw(KernelUtility.PlacementToC(placement));
  @:const auto paged_attention_kv_cache_config = @Html.Raw(kvcacheType.Config.ToC());
  @:using paged_attention_kv_cache_config_t = std::decay_t<decltype(paged_attention_kv_cache_config)>;
  @:using paged_attention_kv_cache_t = caching::paged_attention_kv_cache<paged_attention_kv_cache_mesh_t, paged_attention_kv_cache_config_t>;
  @:using kv_storage_type_t = typename paged_attention_kv_cache_t::kv_storage_type_t;
  @:alignas(paged_attention_kv_cache_t) std::byte p@(name)[sizeof(paged_attention_kv_cache_t) * @size];
  @:for (size_t i = 0; i < @size; ++i) {
    @:const auto &desc = p@(name)_descs[i];
    @:auto kv_addrs = make_tensor_view_from_address((kv_storage_type_t **)desc.kv_cache_addrs.data(), paged_attention_kv_cache_t::kv_addrs_shape);
    @:auto ptr = (paged_attention_kv_cache_t*)p@(name) + i;
    @:new (ptr) paged_attention_kv_cache_t(desc.num_seqs, desc.num_tokens, make_tensor_view_from_address(desc.context_lens, make_shape(desc.context_lens_size)), make_tensor_view_from_address(desc.seq_lens, make_shape(desc.seq_lens_size)), make_tensor_view_from_address(desc.block_table, make_shape(desc.block_table_shape[0], desc.block_table_shape[1], paged_attention_kv_cache_t::id_length)), make_tensor_view_from_address(desc.slot_mapping, make_shape(desc.slot_mapping_shape[0], paged_attention_kv_cache_t::id_length)), kv_addrs);
  @:}
  @:auto @(name) = make_tensor_view_from_address((paged_attention_kv_cache_t *)p@(name), @Html.Raw(dimStr), @Html.Raw(strideStr));
        }
        else {
          throw new NotSupportedException($"Unsupported NTT runtime reference input {referenceType.ElemType}.");
        }
      } else {
  @:auto @(name) = make_tensor_view_from_address((@Html.Raw(qualifiedElemType) *)input_descs[@i].data, @Html.Raw(dimStr), @Html.Raw(strideStr));
      }
    }
  @:
  }

  @foreach (var binding in abi.DynamicDimensions)
  {
  @:dim_t @Html.Raw(binding.Variable.Name) = input_descs[@binding.InputIndex].shape[@binding.DimensionIndex];
  }

  /* prepare caller-allocated outputs */
  @foreach (var outputInfo in abi.Outputs)
  {
    var outputParameter = outputInfo.Parameter;
    var name = IRHelpers.GetIdentityName(outputParameter.Name);
    var shapeExpressions = outputParameter.CheckedShape.ToArray().Select(Model.RenderDimension).ToArray();
    var shapeName = $"{name}_shape";
    var elemType = outputParameter.CheckedDataType.ToC();
    var strides = outputParameter.LayoutAnnotation.Kind switch
    {
      Nncase.TIR.BufferLayoutKind.ExactStrided => $"make_strides({string.Join(", ", outputParameter.LayoutAnnotation.Strides.Select(Model.RenderDimension))})",
      Nncase.TIR.BufferLayoutKind.RuntimeStrided => $"default_strides({shapeName})",
      _ => throw new NotSupportedException($"Unsupported NTT output layout {outputParameter.LayoutAnnotation.Kind} for {outputParameter.Name}."),
    };
    names.Add(name);
  @:auto @Html.Raw(shapeName) = make_shape(@Html.Raw(string.Join(", ", shapeExpressions)));
  @:auto @Html.Raw(name) = make_tensor_view_from_address((@Html.Raw(elemType) *)(output + @outputInfo.Offset.ToString()UL), @Html.Raw(shapeName), @Html.Raw(strides));
  @:
  }

  @if (Model.Options.Hierarchies.Length > 1) {
    throw new NotSupportedException($"not support multi form topology!");
  }
  
  @(Model.PrimFunction.Name)(@(string.Concat(names.Select(x => $"{x}, ")))rdata, block_local_rdata, data, block_local_data, output, output_descs);
}
